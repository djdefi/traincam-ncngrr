<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>TrainCam WebRTC Viewer</title>
<style>
 body { margin:0; background:#000; color:#eee; font:14px system-ui, sans-serif; width:100vw; height:100vh; overflow:hidden; }
 header { padding:0.4rem 0.75rem; width:100%; box-sizing:border-box; background:rgba(0,0,0,0.45); position:fixed; top:0; left:0; display:flex; gap:1rem; align-items:center; z-index:10; backdrop-filter: blur(4px); transition:opacity .4s; }
 h1 { margin:0; font-size:1.1rem; }
 #status { font-size:0.8rem; opacity:0.8; }
 #health { position:fixed; right:4vw; bottom:4vh; z-index:10; display:flex; gap:0.65rem;
           align-items:center; background:rgba(0,0,0,0.65); padding:0.45rem 0.7rem; border-radius:4px;
           font-size:1.15rem; font-weight:650; font-variant-numeric:tabular-nums; }
 #health.health-ok { color:#6ee787; }
 #health.health-warn { color:#f2cc60; }
 #health.health-dead { color:#ff7b72; }
 #liveDot { display:inline-block; min-width:1em; text-align:center; }
 .health-ok #liveDot { color:#1d572c; }
 .health-ok #liveDot.beat { color:#6ee787; }
 #health .clock { color:#eee; font-size:0.82em; font-weight:500; }
 body.kiosk #health { font-size:clamp(24px, 2vw, 36px); right:2vw; bottom:2vh; gap:1rem; flex-wrap:wrap; max-width:90vw; }
 body.kiosk #health .clock { display:none; }
 body.kiosk video, body.kiosk #mjpeg { object-fit:contain; }
 #ui { position:fixed; top:2.4rem; left:0.6rem; z-index:10; display:flex; gap:0.4rem; flex-wrap:wrap; transition:opacity .4s; }
 video, #mjpeg { position:absolute; top:0; left:0; width:100vw; height:100vh; object-fit:cover; background:#000; transition:filter .3s; }
 body.ui-hidden header, body.ui-hidden #ui { opacity:0; pointer-events:none; }
 body.ui-hidden { cursor:none; }
 button { background:#333; color:#eee; border:1px solid #555; padding:0.4rem 0.8rem; cursor:pointer; margin-right:0.4rem; }
 button:hover { background:#444; }
 footer { margin:1rem 0 2rem; font-size:0.7rem; opacity:0.6; }
 .row { margin-top:0.5rem; }
 /* Sits above the video (z-index auto) but below the controls (z-index 10), so a
    volunteer can still reach Connect/Fullscreen while it is up. */
 #offline { position:fixed; inset:0; z-index:5; background:#000; display:flex; flex-direction:column;
            align-items:center; justify-content:center; text-align:center; gap:0.9rem; padding:2rem; }
 #offline[hidden] { display:none; }   /* display:flex would otherwise beat [hidden] */
 #offline h2 { margin:0; font-size:1.7rem; font-weight:600; }
 #offline p { margin:0; max-width:34rem; line-height:1.55; opacity:0.65; }
 #offline .dot { width:11px; height:11px; border-radius:50%; background:#e8b339;
                 animation:pulse 1.6s ease-in-out infinite; }
 @keyframes pulse { 0%,100% { opacity:0.25; transform:scale(0.8); } 50% { opacity:1; transform:scale(1.2); } }
 @media (prefers-reduced-motion: reduce) { #offline .dot { animation:none; opacity:0.8; } }
</style>
</head>
<body>
  <header>
    <h1>TrainCam WebRTC Viewer</h1>
    <div id="status">Idle</div>
  </header>
  <div id="ui" class="row">
    <button id="connectBtn">Connect</button>
    <button id="disconnectBtn" disabled>Disconnect</button>
  <button id="fsBtn">Fullscreen</button>
  <button id="fitBtn" title="Toggle Fill / Fit">Fit</button>
    <label style="font-size:0.75rem;">Auto-reconnect <input type="checkbox" id="autorec" checked></label>
  </div>
  <video id="video" autoplay playsinline muted></video>
  <img id="mjpeg" hidden alt="Live camera view">
  <!-- Public-facing, so it explains rather than reports. Starts VISIBLE: the kiosk
       boots before the camera does, and that gap was previously a black screen.
       Copy claims only measured failure modes - an earlier draft blamed tunnels,
       which the layout does not actually do. The real dropout is WiFi (wlan0 lost
       association for 77s on 2026-08-01, and the SDIO wedge in docs/NETWORK.md). -->
  <div id="offline">
    <div class="dot"></div>
    <h2>Waiting for the train camera&hellip;</h2>
    <p>This camera rides on the train, running on track power with a small battery
       for backup. If the picture pauses it is usually the WiFi &mdash; it comes back on its own.</p>
  </div>
  <div id="health" class="health-warn" aria-label="Stream health">
    <span><span id="liveDot">…</span> <span id="liveText">CHECKING</span></span>
    <span class="clock">Camera <span id="cameraUptime">--</span></span>
    <span id="cameraPower" class="clock" hidden>Power <span id="cameraPowerValue">--</span></span>
    <span id="cameraTemperature" class="clock" hidden>Temp <span id="cameraTemperatureValue">--</span></span>
    <span class="clock">Viewer <span id="viewerUptime">00:00:00</span></span>
  </div>
<script>
const PATH = 'traincam';
if (new URLSearchParams(window.location.search).get('kiosk') === '1') document.body.classList.add('kiosk');
// Derive MediaMTX base (viewer served on 8080; mediamtx on 8889 by default)
// Where to reach MediaMTX. Normally this page is served BY the camera, so the
// port swap below is right. But scripts/setup-kiosk.sh deliberately serves a
// cached copy from the kiosk's OWN localhost, so that a camera which is off,
// on a battery swap, or out of range leaves a retrying page rather than a
// Chromium error page that never retries. In that setup window.location points
// at the kiosk, not the camera, so an explicit ?whepBase= has to win.
const MTX_BASE = (() => {
  const qs = new URLSearchParams(window.location.search);
  const explicit = qs.get('whepBase');
  if (explicit) { try { return new URL(explicit).origin; } catch(_) {} }
  const port = qs.get('whepPort') || '{{ traincam_webrtc_port | default(8889) }}';
  const host = qs.get('whepHost');
  try { const u = new URL(window.location.href); if (host) u.hostname = host; u.port = port; return u.origin; }
  catch(_) { return window.location.origin; }
})();
const AUTOREC_DELAY_MS = 1500;
const AUTOREC_MAX_MS = 15000;
let retryDelay = AUTOREC_DELAY_MS;
let pc, abortController, reconnectTimer, uiHideTimer, connectionDeadline;
const statusEl = document.getElementById('status');
const videoEl = document.getElementById('video');
const connectBtn = document.getElementById('connectBtn');
const disconnectBtn = document.getElementById('disconnectBtn');
const fsBtn = document.getElementById('fsBtn');
const fitBtn = document.getElementById('fitBtn');
const autorec = document.getElementById('autorec');
const offlineEl = document.getElementById('offline');
const healthEl = document.getElementById('health');
const liveDot = document.getElementById('liveDot');
const liveText = document.getElementById('liveText');
const cameraUptimeEl = document.getElementById('cameraUptime');
const cameraPowerEl = document.getElementById('cameraPower');
const cameraPowerValueEl = document.getElementById('cameraPowerValue');
const cameraTemperatureEl = document.getElementById('cameraTemperature');
const cameraTemperatureValueEl = document.getElementById('cameraTemperatureValue');
const viewerUptimeEl = document.getElementById('viewerUptime');
const viewerStartedAt = Date.now();
let lastFrameAt = 0, cameraUptime = null, cameraStatusAt = 0, cameraChecked = false;
let lastPresentedFrame = -Infinity;
let cameraPowerMv = null, cameraTemperatureC = null;
const CAMERA_STATUS = (() => {
  try {
    const u = new URL(MTX_BASE);
    u.port = '{{ traincam_viewer_port | default(8080) }}';
    u.pathname = '/status'; u.search = ''; u.hash = '';
    return u.href;
  } catch (_) { return null; }
})();
function formatDuration(seconds) {
  seconds = Math.max(0, Math.floor(seconds));
  const h = String(Math.floor(seconds / 3600)).padStart(2, '0');
  const m = String(Math.floor(seconds % 3600 / 60)).padStart(2, '0');
  const s = String(seconds % 60).padStart(2, '0');
  return `${h}:${m}:${s}`;
}
function noteCameraStatus(status) {
  cameraUptime = Number(status.uptime_s);
  cameraPowerMv = Number.isFinite(Number(status.battery_mv)) ? Number(status.battery_mv) : null;
  cameraTemperatureC = Number.isFinite(Number(status.temperature_c)) ? Number(status.temperature_c) : null;
  cameraStatusAt = Date.now();
  cameraChecked = true;
}
function healthState(now) {
  const streamLive = MJPEG ? mjpegLive && cameraUptime !== null : lastFrameAt && now - lastFrameAt < 2500;
  if (!cameraChecked) return ['health-warn', '…', 'CHECKING'];
  if (cameraUptime === null) return ['health-dead', '×', 'CAMERA OFFLINE'];
  if (streamLive) return ['health-ok', '▶', 'LIVE'];
  return ['health-warn', '!', 'NO VIDEO'];
}
// Hide it on `timeupdate`, not `playing`: currentTime only advances when frames
// actually land, so this is the same signal the STALL_MS watchdog trusts below.
// `playing` fires on a stream that then stalls, which would clear the card and
// leave the public looking at a black screen again.
videoEl.addEventListener('timeupdate', () => {
  if (!videoEl.paused && videoEl.currentTime > 0) lastPresentedFrame = performance.now();
  if (!offlineEl.hidden) offlineEl.hidden = true;
  lastFrameAt = Date.now();
  // A CSS animation would keep blinking if JavaScript froze. Drive this from
  // the media clock so a stopped pulse means frames really stopped advancing.
  liveDot.classList.toggle('beat', Math.floor(videoEl.currentTime * 2) % 2 === 0);
});
setInterval(() => {
  const now = Date.now();
  viewerUptimeEl.textContent = formatDuration((now - viewerStartedAt) / 1000);
  const [stateClass, symbol, label] = healthState(now);
  healthEl.className = stateClass;
  liveDot.textContent = symbol;
  liveText.textContent = label;
  if (stateClass !== 'health-ok') liveDot.classList.remove('beat');
  else if (MJPEG) liveDot.classList.add('beat');
  cameraUptimeEl.textContent = cameraUptime === null
    ? 'offline'
    : formatDuration(cameraUptime + (now - cameraStatusAt) / 1000);
  cameraPowerEl.hidden = cameraPowerMv === null;
  if (cameraPowerMv !== null) cameraPowerValueEl.textContent = `${(cameraPowerMv / 1000).toFixed(2)} V`;
  cameraTemperatureEl.hidden = cameraTemperatureC === null;
  if (cameraTemperatureC !== null) cameraTemperatureValueEl.textContent = `${cameraTemperatureC.toFixed(1)} °C`;
}, 1000);

// ponytail: ?mjpeg=<url> puts the page in MJPEG mode for the ESP32 cameras. The
// browser is already an MJPEG decoder, so this needs an <img> and no library.
// The ESP32-S3 cannot do WebRTC video worth having: it has no hardware H.264
// encoder (esp_h264 compiles its hw/ path only under IDF_TARGET esp32p4) and
// WebRTC will not carry MJPEG (RFC 7742 s5 mandates VP8/H.264). Espressif's own
// whip_demo settings.h caps S3 at 320x240@10fps. Transcoding MJPEG->H.264
// through the Pi's MediaMTX is possible, but it would make the standalone
// camera depend on the Pi and delete the redundancy that is its whole point.
const MJPEG = new URLSearchParams(window.location.search).get('mjpeg');
const stageEl = MJPEG ? document.getElementById('mjpeg') : videoEl;

function log(msg){ console.log(msg); statusEl.textContent = msg; }
function attemptFullscreen(auto=false){
  if (document.body.classList.contains('kiosk')) return;
  const elem = document.fullscreenElement || document.webkitFullscreenElement;
  if (!elem) stageEl.requestFullscreen?.().catch(()=>{ if(!auto) log('Fullscreen denied'); });
}
function scheduleUIHide(){ clearTimeout(uiHideTimer); uiHideTimer = setTimeout(()=>{ document.body.classList.add('ui-hidden'); }, 2000); }
function showUI(){ document.body.classList.remove('ui-hidden'); scheduleUIHide(); }
['mousemove','keydown','touchstart'].forEach(ev=>window.addEventListener(ev, showUI,{passive:true}));

// WHEP hands back the session URL in the Location header, and the server only
// frees the session when we DELETE it. Without this a tab close, a refresh or
// any reconnect strands a session server-side: MediaMTX keeps writing to a
// reader that stopped reading and burns the wifi TX path on it. Observed 3
// stale sessions at once, one of which ran 28 minutes.
let resource = null;

// ponytail: deliberately NOT on abortController - cleanup() aborts that, which
// would cancel the very request that frees the session. keepalive lets it
// outlive the page on a tab close.
function releaseResource(){
  if (!resource) return;
  const url = resource; resource = null;
  try { fetch(url, {method:'DELETE', keepalive:true, cache:'no-store'}).catch(()=>{}); } catch(_){}
}

async function connect(){
  if (pc) { log('Already connected'); return; }
  abortController = new AbortController();
  log('Creating PeerConnection...');
  // ponytail: `conn` is the local handle; every callback ignores itself once
  // `pc` no longer points at it, so a late event from a dead connection can't
  // tear down the live one.
  const conn = pc = new RTCPeerConnection({ iceServers: [] });
  const fail = msg => { if (pc !== conn) return; log(msg); cleanup(); if (autorec.checked) scheduleReconnect(); };
  connectionDeadline = setTimeout(function connectionTimeout() {
    if (pc === conn && conn.connectionState !== 'connected') fail('Connection timed out');
  }, 12000);
  conn.addEventListener('track', ev => { if (pc === conn && ev.track.kind==='video') videoEl.srcObject = ev.streams[0]; });
  conn.addEventListener('connectionstatechange', () => {
    if (pc !== conn) return;
    if (['disconnected','failed','closed'].includes(conn.connectionState)) fail('State: ' + conn.connectionState);
    else { if (conn.connectionState === 'connected') { clearTimeout(connectionDeadline); retryDelay = AUTOREC_DELAY_MS; lastMediaAt = performance.now(); lastMediaTime = -1; } log('State: ' + conn.connectionState); }
  });
  conn.addTransceiver('video',{direction:'recvonly'});
  try {
    const offer = await conn.createOffer();
    if (pc !== conn) return;
    await conn.setLocalDescription(offer);
    if (pc !== conn) return;
    const base = MTX_BASE.replace(/\/$/,'');
    const resp = await fetch(`${base}/${PATH}/whep`,{method:'POST',body:offer.sdp,headers:{'Content-Type':'application/sdp','Accept':'application/sdp'},cache:'no-store',signal:abortController.signal});
    if (pc !== conn) {
      const abandoned = resp.headers.get('Location');
      if (abandoned) {
        fetch(new URL(abandoned, base).href, { method:'DELETE', keepalive:true, cache:'no-store' })
          .catch(error => console.warn('Could not release abandoned WHEP session', error));
      }
      return;
    }
    if (!resp.ok) throw new Error(`WHEP rejected: ${resp.status}`);
    // Location is relative ("/traincam/whep/<uuid>"), so resolve it against
    // the WHEP origin rather than this page's.
    const loc = resp.headers.get('Location');
    if (loc) { try { resource = new URL(loc, base).href; } catch(_){ resource = null; } }
    const answerSdp = await resp.text();
    await conn.setRemoteDescription({type:'answer', sdp:answerSdp});
  } catch(e){ fail('Connect error: ' + e); return; }
  if (pc !== conn) return;
  log('Connected');
  connectBtn.disabled = true; disconnectBtn.disabled = false; showUI();
}

function cleanup(){ clearTimeout(connectionDeadline); lastPresentedFrame = -Infinity; releaseResource(); if (abortController) abortController.abort(); if (pc){ try{ pc.close(); }catch(_){} } pc=null; lastMediaAt=0;
  // Drop the last frame. Leaving it on screen at a show reads as a train that
  // has stopped, not a camera that has gone away, and nobody comes to look.
  try { videoEl.srcObject = null; } catch(_){}
  offlineEl.hidden = false;
  connectBtn.disabled=false; disconnectBtn.disabled=true; showUI(); }

// A WebRTC session can sit in connectionState "connected" while media has
// stopped arriving, so connectionstatechange never fires and the kiosk shows a
// frozen frame indefinitely. That is not hypothetical here: wlan0 was measured
// dropping the association for 77s at the layout on 2026-08-01
// (NetworkManager reason 'ssid-not-found'). Watch the video clock, which only
// advances when frames actually land, rather than trusting the peer state.
const STALL_MS = 8000;
let lastMediaTime = -1, lastMediaAt = 0;
setInterval(() => {
  if (!pc || pc.connectionState !== 'connected' || !lastMediaAt) return;
  const t = videoEl.currentTime, now = performance.now();
  if (t !== lastMediaTime) { lastMediaTime = t; lastMediaAt = now; return; }
  if (now - lastMediaAt > STALL_MS) { log('Stalled - reconnecting'); cleanup(); if (autorec.checked) scheduleReconnect(); }
}, 2000);
// ponytail: jittered exponential backoff, not a fixed retry. Measured Jul 28:
// ONE tab opened 143 WHEP sessions in 5 minutes, creations 1.57-1.63s apart
// (= AUTOREC_DELAY_MS + round trip), all from a single source port, while the
// SDIO radio was already failing. The jitter matters more than the backoff at
// a show: without it every phone in the hall retries on the same tick and they
// hit the AP together.
function scheduleReconnect(){
  if (reconnectTimer) return;
  const wait = Math.round(retryDelay * (0.75 + Math.random()*0.5));
  retryDelay = Math.min(retryDelay*2, AUTOREC_MAX_MS);
  reconnectTimer = setTimeout(()=>{ reconnectTimer=null; connect(); }, wait);
  log('Reconnecting in '+wait+'ms...');
}
connectBtn.onclick = () => { if (reconnectTimer){ clearTimeout(reconnectTimer); reconnectTimer=null;} retryDelay=AUTOREC_DELAY_MS; connect(); showUI(); };
disconnectBtn.onclick = () => { if (reconnectTimer){ clearTimeout(reconnectTimer); reconnectTimer=null;} autorec.checked=false; cleanup(); log('Disconnected'); };
fsBtn.onclick = () => { attemptFullscreen(false); showUI(); };
fitBtn.onclick = () => { if (stageEl.style.objectFit==='contain'){ stageEl.style.objectFit='cover'; fitBtn.textContent='Fit'; } else { stageEl.style.objectFit='contain'; fitBtn.textContent='Fill'; } showUI(); };
// An MJPEG stream that dies leaves a frozen last frame, the same failure the
// STALL_MS watchdog exists to catch on the WebRTC path. Measured in headless
// Chrome 2026-08-03, an <img> gives us almost nothing to watch:
//   stream cannot be opened at all -> error fires (~200ms)
//   stream cut mid-flight          -> NO event, last frame stays up forever
//   stream stalls, socket open     -> NO event, same
//   load                           -> fires ONCE, not per frame
// So error covers the kiosk-booted-before-the-camera case and nothing else, and
// no listener can see a freeze. Poll the camera's status port for that instead.
const MJPEG_STATUS_PORT = '81';   // firmware serves /status + /control here
const MJPEG_STATUS = new URLSearchParams(window.location.search).get('mjpegStatus');
const MJPEG_POLL_MS = 5000;
let mjpegLive = false;            // true only between a first frame and the next reload
let mjpegStatusAt = -Infinity;
function startMjpeg(){
  videoEl.hidden = true; stageEl.hidden = false;
  connectBtn.disabled = true; disconnectBtn.disabled = true; autorec.checked = true;
  // Cache-bust each retry or the browser will happily re-serve the dead stream.
  let retry = null;
  const load = () => { clearTimeout(retry); mjpegLive = false; mjpegStatusAt = -Infinity; offlineEl.hidden = false; stageEl.src = MJPEG + (MJPEG.includes('?') ? '&' : '?') + 't=' + Date.now(); log('MJPEG ' + MJPEG); };
  stageEl.onload = () => { mjpegLive = true; offlineEl.hidden = true; };
  stageEl.onerror = () => { mjpegLive = false; log('MJPEG lost - retrying'); clearTimeout(retry); retry = setTimeout(load, 2000); };
  load();
  watchMjpeg(load);
}
// ponytail: uptime_s going backwards is the reboot tell, two dead polls in a row
// is the gone tell, and `live` catches the rest - a reconnect that lands while
// the camera is half up gets no load event and no error event, so without it the
// page sits dead while /status reports fine. Covers a wedged stream task too:
// no frame, no load, so every poll retries.
function watchMjpeg(reload){
  let status;
  try {
    const u = new URL(MJPEG_STATUS || MJPEG, location.href);
    if (!MJPEG_STATUS) { u.port = MJPEG_STATUS_PORT; u.pathname = '/status'; u.search = ''; }
    status = u.href;
  } catch (e) { log('MJPEG watchdog off'); return; }
  let lastUp = null, lastSequence = null, fails = 0;
  setInterval(() => {
    fetch(status + '?t=' + Date.now(), { cache: 'no-store', signal: AbortSignal.timeout(3000) })
      .then(r => { if (!r.ok) throw new Error('MJPEG status ' + r.status); return r.json(); })
      .then(s => {
        noteCameraStatus(s);
        const frameSequence = Number(s.frame_sequence);
        const framesAdvanced = Number.isFinite(frameSequence) &&
          (lastSequence === null || frameSequence > lastSequence);
        if (s.frame_age_ms !== undefined && (s.frame_age_ms === null || s.frame_age_ms >= 3000)) {
          throw new Error('MJPEG frames are stale');
        }
        // Relay health cannot prove the browser has received the image.
        if (mjpegLive && (!Number.isFinite(frameSequence) || framesAdvanced)) mjpegStatusAt = performance.now();
        if (lastUp !== null && s.uptime_s < lastUp) { log('Camera rebooted - reconnecting'); reload(); }
        else if (Number.isFinite(frameSequence) && lastSequence !== null && frameSequence <= lastSequence) {
          mjpegLive = false; log('MJPEG frames stopped - reconnecting'); reload();
        }
        else if (!mjpegLive) { log('Camera up but no picture - reconnecting'); reload(); }
        if (Number.isFinite(frameSequence)) lastSequence = frameSequence;
        lastUp = s.uptime_s; fails = 0;
      })
      .catch(() => { mjpegStatusAt = -Infinity; if (++fails >= 2) { cameraUptime = null; cameraChecked = true; log('Camera unreachable - reconnecting'); reload(); lastUp = null; fails = 0; } });
  }, MJPEG_POLL_MS);
}
function pollPiStatus() {
  if (!CAMERA_STATUS) return;
  fetch(CAMERA_STATUS + '?t=' + Date.now(), { cache:'no-store', signal: AbortSignal.timeout(3000) })
    .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then(noteCameraStatus)
    .catch(() => { cameraUptime = null; cameraChecked = true; });
}
window.addEventListener('load', () => {
  if (MJPEG) startMjpeg();
  else { connect(); pollPiStatus(); setInterval(pollPiStatus, 5000); }
  setTimeout(()=>attemptFullscreen(true),600); scheduleUIHide();
  if (window.parent !== window) {
    const heartbeat = () => window.parent.postMessage({
      type: 'traincam-viewer-heartbeat',
      live: MJPEG ? mjpegLive && performance.now() - mjpegStatusAt < 8000
        : performance.now() - lastPresentedFrame < 4000,
    }, location.origin);
    heartbeat();
    setInterval(heartbeat, 2000);
  }
});
// Closing the tab or backgrounding the app on a phone otherwise leaves the
// session open on the server forever - the exact thing a hall full of
// wandering visitors will do all day.
window.addEventListener('pagehide', () => { cleanup(); });
// pagehide also fires when a phone puts the page in the back/forward cache, so
// pick the stream back up if it is restored rather than showing a dead frame.
window.addEventListener('pageshow', ev => { if (ev.persisted && !pc && !MJPEG) connect(); });
</script>
</body>
</html>