#!/usr/bin/env python3
import json
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

SOURCE = "http://{{ trainview_esp32_camera }}/stream"
STATUS = "http://{{ trainview_esp32_camera }}:81/status"
PORT = {{ trainview_esp32_relay_port }}
condition = threading.Condition()
latest = b""
sequence = 0
last_frame_at = 0.0


def read_frame(stream):
    length = None
    while True:
        line = stream.readline()
        if not line:
            raise EOFError
        if line.lower().startswith(b"content-length:"):
            length = int(line.split(b":", 1)[1])
        elif line in (b"\r\n", b"\n") and length is not None:
            return stream.read(length)


def ingest():
    global latest, sequence, last_frame_at
    while True:
        try:
            with urllib.request.urlopen(SOURCE, timeout=10) as stream:
                while True:
                    frame = read_frame(stream)
                    with condition:
                        latest = frame
                        sequence += 1
                        last_frame_at = time.monotonic()
                        condition.notify_all()
        except Exception as error:
            print(f"ESP32 relay reconnecting: {error}", flush=True)
            time.sleep(2)


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        path = self.path.partition("?")[0]
        if path == "/status":
            try:
                with urllib.request.urlopen(STATUS, timeout=3) as response:
                    status = json.load(response)
                with condition:
                    status["frame_sequence"] = sequence
                    status["frame_age_ms"] = round((time.monotonic() - last_frame_at) * 1000) if last_frame_at else None
                payload = json.dumps(status, separators=(",", ":")).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Access-Control-Allow-Origin", "*")
                self.send_header("Content-Length", str(len(payload)))
                self.end_headers()
                self.wfile.write(payload)
            except Exception:
                self.send_error(502)
            return
        if path != "/stream":
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", "multipart/x-mixed-replace; boundary=frame")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        seen = 0
        try:
            while True:
                with condition:
                    condition.wait_for(lambda: sequence != seen)
                    frame, seen = latest, sequence
                self.wfile.write(
                    b"--frame\r\nContent-Type: image/jpeg\r\nContent-Length: "
                    + str(len(frame)).encode()
                    + b"\r\n\r\n"
                    + frame
                    + b"\r\n"
                )
        except (BrokenPipeError, ConnectionResetError):
            pass

    def log_message(self, _format, *_args):
        pass


if __name__ == "__main__":
    threading.Thread(target=ingest, daemon=True).start()
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
