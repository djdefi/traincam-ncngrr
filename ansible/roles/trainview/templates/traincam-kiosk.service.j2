[Unit]
Description=TrainCam kiosk browser
After=graphical-session.target traincam-kiosk-www.service traincam-esp32-relay.service traincam-usb-relay.service
Wants=traincam-kiosk-www.service traincam-esp32-relay.service traincam-usb-relay.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=%t
ExecStartPre=/usr/bin/timeout 90 /bin/sh -c 'until /usr/bin/wlr-randr >/dev/null 2>&1; do sleep 1; done'
ExecStartPre=/bin/rm -rf %t/traincam-chromium-profile-1 %t/traincam-chromium-profile-2
ExecStart=/bin/bash -c '{{ trainview_chromium }} --class=TrainCam-HDMI-1 --noerrdialogs --disable-infobars --disable-session-crashed-bubble --hide-crash-restore-bubble --disable-features=Translate --user-data-dir=%t/traincam-chromium-profile-1 --no-first-run --autoplay-policy=no-user-gesture-required --check-for-update-interval=31536000 "http://localhost:{{ trainview_local_port }}/kiosk.html?output=1" & {{ trainview_chromium }} --class=TrainCam-HDMI-2 --noerrdialogs --disable-infobars --disable-session-crashed-bubble --hide-crash-restore-bubble --disable-features=Translate --user-data-dir=%t/traincam-chromium-profile-2 --no-first-run --autoplay-policy=no-user-gesture-required --check-for-update-interval=31536000 "http://localhost:{{ trainview_local_port }}/kiosk.html?output=usb" & wait -n'
Restart=always
RestartSec=5
