// Copy this file to secrets.h and fill in your network.
// secrets.h is gitignored - this repo is public, so real credentials must
// never be committed. Arduino compiles every .h in the sketch folder's
// include path, so secrets.h sitting alongside the .ino is all that's needed.
#pragma once

#define TRAINCAM_WIFI_SSID     "your-ssid-here"
#define TRAINCAM_WIFI_PASSWORD "your-password-here"
